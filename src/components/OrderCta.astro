import ButtonLink from './ButtonLink.astro';
import DisplayHeading from './DisplayHeading.astro';

interface Props {
  heading: string;
  body?: string | null;
  label?: string | null;
  href: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { heading, body, label = 'Order Online', href, secondaryHref, secondaryLabel } = Astro.props;
---

<!-- The closing gesture is type and space, not another colour block. -->
<section class="canvas gutter-x py-24 md:py-36">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
    <DisplayHeading text={heading} class="text-display lg:col-span-8" />

    <div class="flex flex-col gap-8 lg:col-span-3 lg:col-start-10 lg:justify-end">
      {body && <p class="max-w-sm text-lead text-plum/75">{body}</p>}
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <ButtonLink href={href} variant="solid">{label}</ButtonLink>
        {secondaryHref && secondaryLabel && (
          <ButtonLink href={secondaryHref} variant="text">{secondaryLabel}</ButtonLink>
        )}
      </div>
    </div>
  </div>
</section>
