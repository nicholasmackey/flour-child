import { NAV_LINKS } from '../lib/navigation';
import type { SiteSettings } from '../sanity/types';

import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="on-dark bg-plum">
  <div class="canvas gutter-x pt-20 pb-10 md:pt-28 md:pb-12">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <Logo variant="primary" color="white" alt={settings.businessName} class="w-full max-w-md" />
      </div>

      <nav aria-label="Footer" class="lg:col-span-3 lg:col-start-8">
        <ul class="flex flex-col gap-3">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="quiet-link label border-transparent text-cream/85">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <a
          href={settings.orderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn label bg-cream text-plum hover:bg-buttercream"
        >
          Order Online
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        {settings.footerText && <p class="mt-6 max-w-xs text-cream/70">{settings.footerText}</p>}

        <SocialLinks
          instagramUrl={settings.instagramUrl}
          facebookUrl={settings.facebookUrl}
          label={`${settings.businessName} on social media`}
          class="mt-5"
        />
      </div>
    </div>

    <div class="rule mt-20 flex flex-col gap-2 pt-6 sm:flex-row sm:items-baseline sm:justify-between">
      <p class="label text-cream/60">{settings.locationLabel}</p>
      <p class="label text-cream/60">Copyright {year} {settings.businessName}</p>
    </div>
  </div>
</footer>
