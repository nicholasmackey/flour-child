import { withBase } from '../lib/paths';

const whiskSrc = withBase('/whisk.svg');
---

<div class="whisk-cursor" data-custom-cursor data-visible="false" aria-hidden="true">
  <img class="whisk-cursor__image" src={whiskSrc} alt="" width="24" height="24" />
</div>

<script>
  const cursor = document.querySelector<HTMLElement>('[data-custom-cursor]');
  const finePointer = window.matchMedia('(pointer: fine) and (hover: hover)');

  if (cursor) {
    const ROOT_CLASS = 'has-whisk-cursor';
    const SIZE = 24;
    // The handle ends just inside the SVG's lower-right corner.
    const HOTSPOT_X = 18;
    const HOTSPOT_Y = 23;
    const HOVER_SCALE = 1.12;
    const INTERACTIVE_SELECTOR = [
      'a',
      'button',
      '[role="button"]',
      'summary',
      'input[type="button"]',
      'input[type="submit"]',
      'input[type="reset"]',
      'input[type="image"]'
    ].join(',');
    const NATIVE_TEXT_CURSOR_SELECTOR = [
      'textarea',
      '[contenteditable]:not([contenteditable="false"])',
      'input:not([type])',
      'input[type="text"]',
      'input[type="search"]',
      'input[type="email"]',
      'input[type="password"]',
      'input[type="url"]',
      'input[type="tel"]',
      'input[type="number"]',
      'input[type="date"]',
      'input[type="datetime-local"]',
      'input[type="month"]',
      'input[type="time"]',
      'input[type="week"]'
    ].join(',');

    const clamp = (value: number, minimum: number, maximum: number) =>
      Math.min(Math.max(value, minimum), Math.max(minimum, maximum));

    const hide = () => {
      cursor.dataset.visible = 'false';
      cursor.dataset.interactive = 'false';
    };

    const syncActivation = () => {
      document.documentElement.classList.toggle(ROOT_CLASS, finePointer.matches);
      if (!finePointer.matches) hide();
    };

    const move = (event: PointerEvent) => {
      if (!finePointer.matches || event.pointerType === 'touch') {
        hide();
        return;
      }

      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest(NATIVE_TEXT_CURSOR_SELECTOR)) {
        hide();
        return;
      }

      const isInteractive = Boolean(target?.closest(INTERACTIVE_SELECTOR));

      // Reserve room for the maximum scale even while the hover transition is
      // settling, so no intermediate frame can clip against a viewport edge.
      const minimumX = HOTSPOT_X * (HOVER_SCALE - 1);
      const maximumX = window.innerWidth - HOTSPOT_X - (SIZE - HOTSPOT_X) * HOVER_SCALE;
      const minimumY = HOTSPOT_Y * (HOVER_SCALE - 1);
      const maximumY = window.innerHeight - HOTSPOT_Y - (SIZE - HOTSPOT_Y) * HOVER_SCALE;
      const x = clamp(event.clientX - HOTSPOT_X, minimumX, maximumX);
      const y = clamp(event.clientY - HOTSPOT_Y, minimumY, maximumY);

      cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      cursor.dataset.interactive = String(isInteractive);
      cursor.dataset.visible = 'true';
    };

    syncActivation();
    finePointer.addEventListener('change', syncActivation);
    window.addEventListener('pointermove', move, { passive: true });
    window.addEventListener('blur', hide);
    window.addEventListener('pointercancel', hide);
    document.documentElement.addEventListener('pointerleave', hide);
  }
</script>

<style is:global>
  .whisk-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2147483647;
    display: none;
    width: 24px;
    height: 24px;
    visibility: hidden;
    pointer-events: none;
    contain: layout style;
    transform: translate3d(-48px, -48px, 0);
    will-change: transform;
  }

  .whisk-cursor[data-visible='true'] {
    visibility: visible;
  }

  .whisk-cursor__image {
    display: block;
    width: 24px;
    max-width: none;
    height: 24px;
    transform-origin: 18px 23px;
    filter:
      drop-shadow(0 0 1px rgba(255, 249, 243, 0.95))
      drop-shadow(0 1px 1px rgba(61, 28, 39, 0.65));
    transition: transform 150ms ease, filter 150ms ease;
  }

  .whisk-cursor[data-interactive='true'] .whisk-cursor__image {
    transform: scale(1.12);
    filter:
      drop-shadow(0 0 1px rgba(255, 249, 243, 0.95))
      drop-shadow(0 1px 1px rgba(61, 28, 39, 0.65))
      drop-shadow(0 0 4px rgba(233, 93, 120, 0.8));
  }

  @media (pointer: fine) and (hover: hover) {
    .whisk-cursor {
      display: block;
    }

    html.has-whisk-cursor,
    html.has-whisk-cursor body,
    html.has-whisk-cursor body * {
      cursor: none !important;
    }

    html.has-whisk-cursor :is(
      textarea,
      [contenteditable]:not([contenteditable='false']),
      input:not([type]),
      input[type='text'],
      input[type='search'],
      input[type='email'],
      input[type='password'],
      input[type='url'],
      input[type='tel'],
      input[type='number'],
      input[type='date'],
      input[type='datetime-local'],
      input[type='month'],
      input[type='time'],
      input[type='week']
    ),
    html.has-whisk-cursor [contenteditable]:not([contenteditable='false']) * {
      cursor: text !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whisk-cursor__image {
      transition: none;
    }
  }
</style>
