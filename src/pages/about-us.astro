import ButtonLink from '../components/ButtonLink.astro';
import DisplayHeading from '../components/DisplayHeading.astro';
import PortableText from '../components/PortableText.astro';
import SmartImage from '../components/SmartImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasImage } from '../sanity/image';
import { getAboutPage, getSiteSettings } from '../sanity/queries';

import kitchenPortrait from '../assets/images/story/hailey-kitchen-portrait.webp';
import whiskingPortrait from '../assets/images/story/hailey-whisking.webp';

const [settings, about] = await Promise.all([getSiteSettings(), getAboutPage()]);

const supporting = (about.supportingImages ?? []).filter(hasImage);
const supportingShapes = ['3 / 4', '1 / 1', '4 / 5'];
---

<BaseLayout
  title={about.seoTitle ?? `Our Story | ${settings.businessName}`}
  description={
    about.seoDescription ??
    'How Flour Child started: Hailey moved from Arizona to Forney, Texas, and began baking gluten-free for her mom.'
  }
>
  <!-- The portrait runs to the edge and the headline sits beside it, low. -->
  <section class="canvas">
    <div class="grid lg:grid-cols-12">
      <div class="order-1 aspect-[4/5] sm:aspect-[3/2] lg:order-2 lg:col-span-6 lg:col-start-7 lg:aspect-[4/5]">
        <SmartImage
          image={about.portrait}
          fallback={whiskingPortrait}
          alt="Hailey standing in her pink kitchen holding a whisk and a mixing bowl"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          aspectRatio={4 / 5}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
          frameLabel="Hailey"
        />
      </div>

      <div class="gutter-x order-2 flex flex-col justify-end pt-10 pb-2 lg:order-1 lg:col-span-6 lg:pb-16">
        <p class="label text-pink-deep">Our Story</p>
        <DisplayHeading as="h1" text={about.heading} class="mt-8 text-display" />
        {about.intro && <p class="mt-8 max-w-md text-lead text-plum/75">{about.intro}</p>}
      </div>
    </div>
  </section>

  <section class="canvas gutter-x py-24 md:py-32">
    <div class="grid gap-10 lg:grid-cols-12">
      <p class="label text-plum/70 lg:col-span-2">{settings.locationLabel}</p>
      <div class="prose-fc lg:col-span-7 lg:col-start-4">
        <PortableText blocks={about.story} />
      </div>
    </div>
  </section>

  {
    supporting.length > 0 ? (
      <section class="canvas gutter-x pb-24 md:pb-32">
        <div class="grid gap-8 sm:grid-cols-3 sm:items-start">
          {supporting.map((image, index) => (
            <figure class:list={[index % 3 === 1 ? 'sm:mt-16' : '']}>
              <div style={`aspect-ratio: ${supportingShapes[index % supportingShapes.length]}`}>
                <SmartImage
                  image={image}
                  alt={image.alt ?? ''}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 640px) 32vw, 100vw"
                  class="h-full w-full object-cover"
                />
              </div>
              {image.caption && <figcaption class="mt-3 text-plum/75">{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    ) : (
      <section class="canvas pb-24 md:pb-32">
        <div class="grid items-end gap-10 lg:grid-cols-12">
          <div class="aspect-[4/3] lg:col-span-7 lg:aspect-[5/4]">
            <SmartImage
              fallback={kitchenPortrait}
              alt="Hailey at her kitchen counter behind trays of scones, cookies and cinnamon rolls"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="gutter-x lg:col-span-4 lg:col-start-9 lg:pb-6">
            <h2 class="text-headline">Small batches, one kitchen</h2>
            <p class="mt-6 max-w-sm text-lead text-plum/75">
              Everything is baked here in {settings.locationLabel}, in batches small enough to keep an eye on.
            </p>
            <p class="mt-8">
              <a href="/find-us" class="quiet-link label text-plum">Where to find it</a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="canvas gutter-x pb-24 md:pb-32">
    <div class="rule grid gap-8 pt-8 lg:grid-cols-12">
      {about.closingHeading && <DisplayHeading text={about.closingHeading} class="text-display lg:col-span-7" />}
      <div class="lg:col-span-4 lg:col-start-9">
        {about.closingBody && <p class="text-lead text-plum/75">{about.closingBody}</p>}
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <ButtonLink href={settings.orderUrl} variant="solid">Order Online</ButtonLink>
          <ButtonLink href="/menu" variant="text">See the Menu</ButtonLink>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
