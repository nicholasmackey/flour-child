# Sanity project the site and the embedded Studio at /studio read from.
# These are public identifiers, not secrets.
PUBLIC_SANITY_PROJECT_ID=491tvf4i
PUBLIC_SANITY_DATASET=production

# The address the site will live at. Used for canonical links, sharing cards,
# robots.txt and sitemap.xml. Leave it out locally and it falls back to
# http://localhost:4321.
PUBLIC_SITE_URL=https://example.com

# Never put a Sanity write token in a PUBLIC_ variable. Tokens are only needed
# for scripted writes, and the seed import below uses the Sanity CLI login
# instead of a token.
